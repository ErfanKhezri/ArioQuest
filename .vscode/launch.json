{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend: run server",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/backend/cmd/server",
      "cwd": "${workspaceFolder}/backend",
      "env": {
        "ARIO_ADDR": ":8080",
        "ARIO_DB": "ario.db"
      }
    },
    {
      "name": "Backend: test current package",
      "type": "go",
      "request": "launch",
      "mode": "test",
      "program": "${fileDirname}"
    }
  ]
}
